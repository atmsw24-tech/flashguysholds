# ==========================================
# FLASHGUYS
# Environment Variables
# ==========================================

# Frontend API
VITE_API_BASE_URL=/api

# Solana
SOLANA_RPC_URL=
VITE_SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# Robinhood Chain Mainnet
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_FLASHBOYS_FACTORY_ADDRESS=
# Comma-separated contract addresses excluded from holder snapshots (curve,pool,adapter,factory,router,vault)
HOLDER_EXCLUDE_ADDRESSES=

# Optional provider credentials
BLOCKSCOUT_API_KEY=
BIRDEYE_API_KEY=
SOLANA_PROVIDER_API_KEY=
ROBINHOOD_PROVIDER_API_KEY=

# PostgreSQL
DATABASE_URL=

# Indexer
INDEXER_POLL_MS=5000

# Never place private keys in this file.
# Never commit .env to GitHub.

# Supabase Auth + profile storage (set these in Vercel, not in committed secrets)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
