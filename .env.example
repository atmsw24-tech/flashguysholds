# ==========================================
# FLASHGUYS
# Environment Variables
# ==========================================

# Frontend API
VITE_API_BASE_URL=/api

# Solana
SOLANA_RPC_URL=

# Robinhood Chain Mainnet
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional provider credentials
BLOCKSCOUT_API_KEY=
BIRDEYE_API_KEY=
SOLANA_PROVIDER_API_KEY=
ROBINHOOD_PROVIDER_API_KEY=

# PostgreSQL
DATABASE_URL=

# Indexer
INDEXER_POLL_MS=5000

# Never place private keys in this file.
# Never commit .env to GitHub.

# Supabase Auth + profile storage (set these in Vercel, not in committed secrets)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
